# Auth0 Configuration
# Get these from your Auth0 dashboard > Applications > Your App > Settings
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here
VITE_AUTH0_AUDIENCE=https://your-api-identifier
VITE_AUTH0_CALLBACK_URL=http://localhost:5173/app
# Optional: must match Auth0 Allowed Logout URLs exactly (defaults to window.location.origin)
# VITE_AUTH0_LOGOUT_URL=http://localhost:5173
# Optional: comma-separated extra origins for logout validation hints
# VITE_AUTH0_ALLOWED_ORIGINS=https://your-app.vercel.app
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
# Optional: must match the namespace used by the Auth0 Action for access-token claims.
AUTH0_CLAIM_NAMESPACE=https://husky-review.app/claims
# Server-only: comma-separated origins allowed to call /api (CORS)
AUTH0_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app
# Server-only: protects /api/cron/purge-expired-resumes
CRON_SECRET=generate_a_long_random_secret

# Supabase Configuration
# Get these from your Supabase project > Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only (Vercel environment variables)
# Set these in your Vercel project settings or .env.local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional server-only AI key for /api/reviews/analyze.
# When set, each signed-in user gets 2 app-key AI reviews per 7-day window.
# Users can provide their own Anthropic key in the app to run additional reviews.
# When omitted locally, Husky-Review uses deterministic catalog matching.
ANTHROPIC_API_KEY=your_anthropic_key_here
